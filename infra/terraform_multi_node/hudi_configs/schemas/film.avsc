{
  "type": "record",
  "name": "film",
  "namespace": "public",
  "fields": [
    {"name": "film_id",           "type": "int"},
    {"name": "title",             "type": ["null", "string"], "default": null},
    {"name": "description",       "type": ["null", "string"], "default": null},
    {"name": "release_year",      "type": ["null", "int"],    "default": null},
    {"name": "language_id",       "type": ["null", "int"],    "default": null},
    {"name": "rental_duration",   "type": ["null", "int"],    "default": null},
    {"name": "rental_rate",       "type": ["null", "string"], "default": null},
    {"name": "length",            "type": ["null", "int"],    "default": null},
    {"name": "replacement_cost",  "type": ["null", "string"], "default": null},
    {"name": "rating",            "type": ["null", "string"], "default": null},
    {"name": "last_update",       "type": ["null", "string"], "default": null},
    {"name": "special_features",  "type": ["null", {"type": "array", "items": "string"}], "default": null},
    {"name": "fulltext",          "type": ["null", "string"], "default": null},
    {"name": "__ts_ms",           "type": ["null", "long"],   "default": null},
    {"name": "__op",              "type": ["null", "string"],  "default": null},
    {"name": "__deleted",         "type": ["null", "string"],  "default": null}
  ]
}
