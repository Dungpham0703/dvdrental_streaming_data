# ==============================================================================
# Terraform Variables Template (AWS Single/Multi Node Infrastructure)
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# SSH Public Key for EC2 key-pair access
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQC... your_email@domain.com"

# Master PostgreSQL RDS password (minimum 8 characters)
db_password = "your_secure_rds_password_here"

# S3 Bucket for Lakehouse Storage
s3_bucket_name = "your-unique-lakehouse-s3-bucket"

# AWS Region & Instance sizing
aws_region    = "ap-southeast-2"
instance_type = "m7i-flex.large"

# Admin CIDR for SSH access restriction (replace with your public IP /32)
admin_cidr = "YOUR_IP_ADDRESS/32"

# Airflow Admin credentials & Alerting
airflow_admin_username = "admin"
airflow_admin_password = "your_airflow_password_here"
slack_webhook_url      = "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"
