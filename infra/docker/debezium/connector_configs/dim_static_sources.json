{
  "name": "rds-postgres-dim-static-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "plugin.name": "pgoutput",

    "database.hostname": "${env:DB_HOST}",
    "database.port": "5432",
    "database.user": "${env:DB_USER}",
    "database.password": "${env:DB_PASS}",
    "database.dbname": "${env:DB_NAME}",
    "topic.prefix": "cdc",

    "table.include.list": "public.language,public.category,public.country,public.city,public.actor,public.address,public.film_actor,public.film_category",
    "snapshot.mode": "always",
    "slot.name": "debezium_dim_static_slot",
    "publication.name": "debezium_dim_static_pub",
    "publication.autocreate.mode": "filtered",
    "decimal.handling.mode": "string",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,ts_ms"
  }
}
