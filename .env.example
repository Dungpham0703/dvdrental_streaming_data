# --- Database Source (PostgreSQL / AWS RDS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_postgres_password_here

# --- Synthetic Data Generation / Stress Test Benchmark ---
BATCH_SIZE=50000
NUM_WORKERS=4
OP_INSERT_PCT=60
OP_UPDATE_PCT=25
OP_DELETE_PCT=15
SLEEP_BETWEEN_BATCHES=0.2
TARGET_SIZE_GB=10

# --- Kafka Broker (Local / Cloud) ---
KAFKA_BROKER_IP=127.0.0.1
KAFKA_PORT=9092
KAFKA_ADVERTISED_IP=127.0.0.1

# --- AWS Cloud Resources (S3, Athena, Glue) ---
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=your-lakehouse-s3-bucket-name
ATHENA_S3_OUTPUT=s3://your-lakehouse-s3-bucket-name/athena-results/

# --- Apache Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
